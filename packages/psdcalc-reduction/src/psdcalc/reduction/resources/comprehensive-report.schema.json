          "type": "string"
        },
        "mapping_coverage": {
          "$ref": "#/$defs/EvidenceValue"
        },
        "preserved_identity_count": {
          "$ref": "#/$defs/EvidenceValue"
        },
        "source_count": {
          "$ref": "#/$defs/EvidenceValue"
        },
        "source_identity_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"

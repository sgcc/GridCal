      "type": "object"
    },
    "EvidenceStatus": {
      "description": "Availability state for one report value.",
      "enum": [
        "AVAILABLE",
        "NOT_RECORDED",
        "NOT_AVAILABLE",
        "NOT_APPLICABLE"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceValue": {
      "additionalProperties": false,
      "description": "One scalar or small histogram plus its explicit evidence state.",
      "properties": {
        "mapping_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Coverage"
        },
        "outcome": {
          "$ref": "#/$defs/MetricOutcome",
          "default": "NOT_EVALUATED"
        },
        "sample_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "source_identity_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identity Digest"
        },
        "state": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "NOT_RECORDED"
        },
        "target_identity_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Identity Digest"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "EvidenceValue",
      "type": "object"
    },
    "FidelityObservation": {
      "additionalProperties": false,
      "description": "One existing PF/Fidelity measurement, optionally grouped by topology.",
      "properties": {
        "group": {
          "$ref": "#/$defs/MetricGroup"
        },
        "identity_binding_status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "NOT_RECORDED"
        },
        "mapping_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Coverage"
        },
        "mapping_coverage_status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "NOT_RECORDED"
        },
        "metric_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Digest"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"

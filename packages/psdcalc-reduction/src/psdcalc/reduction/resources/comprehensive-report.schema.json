      "title": "ComponentMappingSummary",
      "type": "object"
    },
    "ComprehensiveRunReport": {
      "additionalProperties": false,
      "description": "Complete A\u2013F report sections for one immutable experiment identity.",
      "properties": {
        "fidelity": {
          "$ref": "#/$defs/FidelitySection"
        },
        "opportunity": {
          "$ref": "#/$defs/OpportunitySection"
        },
        "performance": {
          "$ref": "#/$defs/PerformanceSection"
        },
        "provenance": {
          "$ref": "#/$defs/ReportProvenance"
        },
        "retained_network_fidelity": {
          "$ref": "#/$defs/RetainedNetworkFidelityReport"
        },
        "source_inventory": {

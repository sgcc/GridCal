            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "source_identity_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identity Digest"
        },
        "target_identity_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

{
  "$defs": {
    "HistoricalObservation": {
      "additionalProperties": false,
      "description": "One allowlisted, source-preserving historical scalar observation.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "NOT_RECORDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "status"
      ],
      "title": "HistoricalObservation",
      "type": "object"
    },
    "HistoricalScenarioEvidence": {
      "additionalProperties": false,
      "description": "Anonymous evidence row with its original experiment and file binding.",
      "properties": {
        "case_label": {
          "enum": [
            "BEIJING",
            "JILIN",
            "NOT_RECORDED"
          ],
          "title": "Case Label",
          "type": "string"
        },
        "declared_schema": {
          "title": "Declared Schema",
          "type": "string"
        },
        "evaluation_convention": {
          "title": "Evaluation Convention",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "implementation_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementation Commit"
        },
        "implementation_tree": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementation Tree"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HistoricalObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Package Version"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "software_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Software Versions",
          "type": "object"
        },
        "source_document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Document Sha256",
          "type": "string"
        },
        "source_model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Model Sha256"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "threshold_set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Set Id"
        },
        "threshold_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Sha256"
        }
      },
      "required": [
        "source_name",
        "source_document_sha256",
        "declared_schema",
        "experiment_id",
        "scenario_id",
        "case_label",
        "package_version",
        "evaluation_convention"
      ],
      "title": "HistoricalScenarioEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned archive schema for anonymous historical report evidence.",
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/HistoricalScenarioEvidence"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "psdcalc-comprehensive-historical-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "title": "HistoricalEvidenceBundle",
  "type": "object"
}

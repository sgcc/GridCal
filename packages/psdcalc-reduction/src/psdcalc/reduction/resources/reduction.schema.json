              "$ref": "#/$defs/LoadStrategies"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OnePortStrategies",
      "type": "object"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "description": "First-batch and known future output toggles.",
      "properties": {
        "save_all_levels": {
          "default": false,
          "title": "Save All Levels",
          "type": "boolean"
        },
        "save_maps": {
          "default": true,
          "title": "Save Maps",
          "type": "boolean"
        },
        "save_metrics_parquet": {
          "default": false,
          "title": "Save Metrics Parquet",
          "type": "boolean"
        },
        "save_original_snapshot": {
          "default": true,
          "title": "Save Original Snapshot",
          "type": "boolean"
        },
        "save_records": {
          "default": true,
          "title": "Save Records",
          "type": "boolean"
        },
        "save_validation_evidence": {
          "default": true,
          "title": "Save Validation Evidence",
          "type": "boolean"
        }
      },
      "title": "OutputConfig",
      "type": "object"
    },
    "PartitionConfig": {
      "additionalProperties": false,
      "description": "Planner selection and connectivity policy.",
      "properties": {
        "connectivity_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "split_disconnected"
          ],
          "title": "Connectivity Policy",
          "type": "string"
        },
        "custom_busmap": {
          "$ref": "#/$defs/CustomBusmapConfig"
        },
        "max_cluster_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cluster Size"
        },
        "min_cluster_size": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Min Cluster Size",
          "type": "integer"
        },
        "options": {
          "$ref": "#/$defs/PartitionOptions"
        },
        "planner": {
          "enum": [
            "custom_busmap",
            "pypsa_kmeans",
            "pypsa_hac",
            "pypsa_modularity"
          ],
          "title": "Planner",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PartitionTarget"
        }
      },
      "required": [
        "planner",
        "target"
      ],
      "title": "PartitionConfig",
      "type": "object"
    },
    "PartitionOptions": {
      "additionalProperties": false,
      "description": "Allowlisted PyPSA clustering options.",
      "properties": {
        "affinity": {
          "default": "euclidean",
          "title": "Affinity",
          "type": "string"
        },
        "linkage": {
          "default": "ward",
          "title": "Linkage",
          "type": "string"
        },
        "n_init": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "N Init",
          "type": "integer"
        }
      },
      "title": "PartitionOptions",
      "type": "object"
    },
    "PartitionTarget": {
      "additionalProperties": false,
      "description": "Single-level target cluster count or ratio.",
      "properties": {
        "n_clusters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Clusters"
        },
        "per_layer": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Per Layer",
          "type": "object"
        },
        "ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "type": {
          "default": "count",
          "enum": [
            "count",
            "ratio",
            "from_hierarchy_level"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "PartitionTarget",
      "type": "object"
    },
    "PipelineConfig": {

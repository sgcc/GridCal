    "RunConfig": {
      "additionalProperties": false,
      "description": "Run identity and reproducibility settings.",
      "properties": {
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "output_dir": {
          "default": "runs",

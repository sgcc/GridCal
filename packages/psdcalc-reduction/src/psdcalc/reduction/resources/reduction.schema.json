            "aggregation",
            "simplification",
            "equivalencing",
            "hybrid",
            "multi_voltage_quotient"
          ],
          "title": "Materialization Family",
          "type": "string"
        },
        "materialize_from": {
          "default": "original",
          "enum": [
            "original",
            "parent"
          ],
          "title": "Materialize From",
          "type": "string"
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "PluginsConfig": {
      "additionalProperties": false,

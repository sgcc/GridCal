        },
        "state": {
          "$ref": "#/$defs/StateLiftingConfig"
        }
      },
      "title": "LiftingConfig",
      "type": "object"
    },
    "LoadStrategies": {
      "additionalProperties": false,
      "description": "Allowlisted load aggregation strategy names.",
      "properties": {
        "p_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Set"
        },
        "q_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q Set"
        }
      },
      "title": "LoadStrategies",
      "type": "object"
    },
    "MappingConfig": {
      "additionalProperties": false,
      "description": "Persistent mapping artifact settings.",
      "properties": {
        "preserve_source_ids": {
          "default": true,
          "title": "Preserve Source Ids",
          "type": "boolean"
        },
        "record_control_ownership": {
          "default": true,
          "title": "Record Control Ownership",
          "type": "boolean"
        },
        "record_device_ownership": {
          "default": true,
          "title": "Record Device Ownership",
          "type": "boolean"
        },
        "require_complete_bus_map": {
          "default": true,
          "title": "Require Complete Bus Map",
          "type": "boolean"

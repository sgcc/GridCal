        },
        "p_nom_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Nom Max"
        },
        "p_nom_min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Nom Min"
        }
      },
      "title": "GeneratorStrategies",
      "type": "object"
    },
    "HierarchyConfig": {
      "additionalProperties": false,
      "description": "Known future hierarchy settings.",
      "properties": {
        "levels": {
          "items": {
            "$ref": "#/$defs/HierarchyLevel"
          },
          "title": "Levels",
          "type": "array"
        },
        "nested": {
          "default": false,
          "title": "Nested",
          "type": "boolean"
        }
      },
      "title": "HierarchyConfig",
      "type": "object"
    },
    "HierarchyLevel": {
      "additionalProperties": false,
      "description": "Known future level specification.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ratio": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Ratio",
          "type": "number"
        }
      },
      "required": [
        "id",
        "ratio"
      ],
      "title": "HierarchyLevel",
      "type": "object"
    },
    "InputConfig": {
      "additionalProperties": false,
      "description": "PyPSA input artifact and source namespace.",
      "properties": {
        "backend": {
          "const": "pypsa",
          "title": "Backend",
          "type": "string"
        },
        "format": {
          "enum": [
            "netcdf",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source_namespace": {
          "title": "Source Namespace",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "path",
        "format",
        "source_namespace"
      ],
      "title": "InputConfig",
      "type": "object"
    },
    "LiftingConfig": {
      "additionalProperties": false,
      "description": "Disabled future lifting declarations.",

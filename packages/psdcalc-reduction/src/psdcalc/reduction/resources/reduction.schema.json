{
  "$defs": {
    "AcceptanceConfig": {
      "additionalProperties": false,
      "description": "Known future physical acceptance settings.",
      "properties": {
        "max_mismatch_pu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Mismatch Pu"
        },
        "require_convergence": {
          "default": false,
          "title": "Require Convergence",
          "type": "boolean"
        },
        "require_hard_constraints": {
          "default": false,
          "title": "Require Hard Constraints",
          "type": "boolean"
        }
      },
      "title": "AcceptanceConfig",
      "type": "object"
    },
    "AggregationConfig": {
      "additionalProperties": false,
      "description": "PyPSA quotient options.",
      "properties": {
        "aggregate_one_ports": {
          "items": {
            "type": "string"
          },
          "title": "Aggregate One Ports",
          "type": "array"
        },
        "backend": {
          "const": "pypsa",
          "default": "pypsa",
          "title": "Backend",
          "type": "string"
        },
        "invariants": {
          "items": {
            "$ref": "#/$defs/AggregationInvariantConfig"
          },
          "title": "Invariants",
          "type": "array"
        },
        "line_length_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Line Length Factor",
          "type": "number"
        },
        "preserve_components": {
          "items": {
            "type": "string"
          },
          "title": "Preserve Components",
          "type": "array"
        },
        "strategies": {
          "$ref": "#/$defs/AggregationStrategies"
        }
      },
      "title": "AggregationConfig",
      "type": "object"
    },
    "AggregationInvariantConfig": {
      "additionalProperties": false,
      "description": "Explicit supported invariant for final structural validation.",
      "properties": {
        "atol": {
          "default": 1e-09,
          "minimum": 0,
          "title": "Atol",
          "type": "number"
        },
        "attribute": {
          "minLength": 1,
          "title": "Attribute",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "dynamic": {
          "default": false,
          "title": "Dynamic",
          "type": "boolean"
        },
        "scope": {
          "default": "target",
          "enum": [
            "target",
            "source_connected_component",
            "global"
          ],
          "title": "Scope",
          "type": "string"
        },
        "snapshots": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshots"
        },
        "strategy": {
          "enum": [
            "sum",
            "preserve_exact"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "component",
        "attribute",
        "strategy"
      ],
      "title": "AggregationInvariantConfig",
      "type": "object"
    },
    "AggregationStrategies": {
      "additionalProperties": false,
      "description": "Known PyPSA aggregation strategy groups.",
      "properties": {
        "generators": {
          "$ref": "#/$defs/GeneratorStrategies"
        },
        "one_ports": {
          "$ref": "#/$defs/OnePortStrategies"
        }
      },
      "title": "AggregationStrategies",
      "type": "object"
    },
    "ControlLiftingConfig": {
      "additionalProperties": false,
      "description": "Known future control lifting settings.",
      "properties": {
        "allow_discrete_aggregation": {
          "default": false,
          "title": "Allow Discrete Aggregation",
          "type": "boolean"
        },
        "allow_unit_aggregation": {
          "default": false,
          "title": "Allow Unit Aggregation",
          "type": "boolean"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "title": "ControlLiftingConfig",
      "type": "object"
    },
    "CostAccountingConfig": {
      "additionalProperties": false,
      "description": "Known future full-chain cost settings.",
      "properties": {
        "include_construction": {
          "default": false,
          "title": "Include Construction",
          "type": "boolean"
        },
        "include_correction": {
          "default": false,
          "title": "Include Correction",
          "type": "boolean"
        },
        "include_lifting": {
          "default": false,
          "title": "Include Lifting",
          "type": "boolean"
        },
        "include_planning": {
          "default": false,
          "title": "Include Planning",
          "type": "boolean"
        },
        "include_refinement": {
          "default": false,
          "title": "Include Refinement",
          "type": "boolean"
        },
        "include_solve": {
          "default": false,
          "title": "Include Solve",
          "type": "boolean"
        },
        "include_validation": {
          "default": false,
          "title": "Include Validation",
          "type": "boolean"
        },
        "report_amortization": {
          "default": false,
          "title": "Report Amortization",
          "type": "boolean"
        }
      },
      "title": "CostAccountingConfig",
      "type": "object"
    },
    "CustomBusmapConfig": {
      "additionalProperties": false,
      "description": "Custom busmap artifact path.",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "title": "CustomBusmapConfig",
      "type": "object"
    },
    "EquivalenceConfig": {
      "additionalProperties": false,
      "description": "Known future electrical equivalence settings.",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "base_operating_point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Operating Point"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "title": "EquivalenceConfig",
      "type": "object"
    },
    "FeatureBuilder": {
      "additionalProperties": false,
      "description": "Known feature builder declaration.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "geographic_xy",
            "load_generation",
            "renewable_profile",
            "renewable_time",
            "electrical_distance",
            "qv_sensitivity"
          ],
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "type"
      ],
      "title": "FeatureBuilder",
      "type": "object"
    },
    "FeaturesConfig": {
      "additionalProperties": false,
      "description": "Planner feature declarations.",
      "properties": {
        "builders": {
          "items": {
            "$ref": "#/$defs/FeatureBuilder"
          },
          "title": "Builders",
          "type": "array"
        }
      },
      "title": "FeaturesConfig",
      "type": "object"
    },
    "FullGridValidationConfig": {
      "additionalProperties": false,
      "description": "Known future full-grid validation settings.",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "independent_solver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Solver"
        },
        "require_candidate_materialization": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Require Candidate Materialization"
        },
        "solver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solver"
        }
      },
      "title": "FullGridValidationConfig",
      "type": "object"
    },
    "GeneratorStrategies": {
      "additionalProperties": false,
      "description": "Allowlisted generator aggregation strategy names.",
      "properties": {
        "committable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
